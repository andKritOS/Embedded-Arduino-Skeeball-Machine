//--------------------------------------------------------------------------------------------------------

void setup() {

pinMode(SERVO_PIN,INPUT); //mounts servo
pinMode(PIEZO_PIN, OUTPUT); //mounts piezo buzzer
pinMode(STEPPER_PIN, OUTPUT);
gate.attach(SERVO_PIN);  //attaches the servo on pin 2 to the servo object
gate.write(gateClosedPos); //immediately closes marble gate

Serial.begin(9600); //initiates baudrate

}

//----------------------------------------------------
void loop() {
delay(100);
coinCheck();
if (gameInProgress == true){

checkMarbleState();
updateStepper();
 
}
if (gameBallCount == 10){
endGame();
}
}

//----------------------------------------------------
//primary logic functions

void checkMarbleState(){

for (int i = 0; i <= 4; i++){

  if (photoBounceChk(i,i) == 1 ){

      newScore = scoreHoleScore[i];
      gameScore += newScore;
      gameBallCount += 1;
      updateStepper();
      updateScoreBoard(); 
      scoreSound(i);

  }
}  
}

void updateScoreBoard() {

  Serial.println(gameScore);
  if(gameInProgress == false){
    Serial.println(9999);
  }
}

void coinCheck() {

if(photoBounceChk(coinSlotPin,5) == 1){
      gamesRemaining += 1;
    if(gameInProgress == false){
      beginGame();   
    }
    else{
      gamesRemaining += 1;

    }
  }
}

void beginGame() {
  startSound();
  Serial.println(0);
  gamesRemaining -= 1;
  gameInProgress = true; 
  releaseMarbles();
}

void endGame() {
  gameInProgress = false; 
  gameScore = 0;
  gameBallCount = 0;
  newScore = 0;
  Serial.println(0);
  delay(5);
  endSound();
}


//--------------------------------------------------------------------------------------------------------
//motor functions
void updateStepper() {

if (gameInProgress == true){
  digitalWrite(STEPPER_PIN,HIGH);
  delay (15);
  digitalWrite(STEPPER_PIN,LOW);
}
else{
  //STEPPER SPEED TO ZERO
}
//stepper.step(256);
}

void releaseMarbles() {

    gate.write(gateOpenPos);
    delay(mrblRlsTime);
    gate.write(gateClosedPos);

}

//--------------------------------------------------------------------------------------------------------
//sounds
void playSound(int frequency, int duration) {

  tone(PIEZO_PIN, frequency, duration);
  delay(duration + 10); // Add a small delay to distinguish between consecutive sounds
}

void startSound() {
//plays a sound to indicate starting a new game
  playSound(scoreHoleSound[0], SHORT_NOTE_DURATION);
  delay(10);
  playSound(scoreHoleSound[1], SHORT_NOTE_DURATION);
  delay(5);
  playSound(scoreHoleSound[2], SHORT_NOTE_DURATION);
  delay(5);
  playSound(scoreHoleSound[3], SHORT_NOTE_DURATION);
  delay(5);
  playSound(scoreHoleSound[4], SHORT_NOTE_DURATION);
  delay(10);
  playSound(scoreHoleSound[3], SHORT_NOTE_DURATION);
  delay(10);
  playSound(scoreHoleSound[4], SHORT_NOTE_DURATION);
  delay(10);

}

void scoreSound(int scoreHole) {
//plays a sound to indicate scoring a point

playSound(scoreHoleSound[scoreHole] , SHORT_NOTE_DURATION);
}

void endSound() {
//plays a sound to indicate ending a game  
  playSound(scoreHoleSound[4], SHORT_NOTE_DURATION);
  delay(10);
  playSound(scoreHoleSound[3], SHORT_NOTE_DURATION);
  delay(5);
  playSound(scoreHoleSound[2], SHORT_NOTE_DURATION);
  delay(5);
  playSound(scoreHoleSound[1], SHORT_NOTE_DURATION);
  delay(5);
  playSound(scoreHoleSound[0], SHORT_NOTE_DURATION);
  delay(10);
  playSound(scoreHoleSound[1], SHORT_NOTE_DURATION);
  delay(10);
  playSound(scoreHoleSound[2], SHORT_NOTE_DURATION);
  delay(10);

}
//--------------------------------------------------------------------------------------------------------
int photoBounceChk(int pin, int thresh){
  
int a,b;
a = analogRead(pin);
delay(5);
b = analogRead(pin);

if (abs(a - b) >= photoBounceThresh[thresh]){
return 1; 
}
else{
return 0;
}    
}
